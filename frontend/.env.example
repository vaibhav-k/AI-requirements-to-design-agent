# Copy to .env and fill in after completing the "Frontend: Entra ID App
# Registration" section of the root README. All VITE_* vars are baked into
# the built JS bundle at build time (Vite convention) - none of these are
# secrets (an SPA can't hold one), but they are still environment-specific.

# Tenant id - same tenant as the backend's ENTRA_TENANT_ID.
VITE_ENTRA_TENANT_ID=

# Client id of the frontend's OWN app registration (SPA platform), not the
# backend API's client id - see the README for why these must be separate.
VITE_ENTRA_CLIENT_ID=

# The backend API's exposed scope, e.g. api://<api-client-id>/access_as_user
# (matches the backend's ENTRA_API_SCOPE, in URI form).
VITE_API_SCOPE=

# Where the FastAPI backend is running. Defaults to this if unset.
VITE_API_BASE_URL=http://localhost:8000
