AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_MODEL=your-deployment-name

AZURE_STORAGE_CONNECTION_STRING=your-storage-connection-string
AZURE_STORAGE_CONTAINER=requirements
AZURE_STORAGE_ENVIRONMENT=dev

# --- Document Intelligence (optional) ---
# Only needed to scan PDF/DOCX/PNG/JPG/JPEG files for requirements; typed
# text input works without these. See README "File Upload for
# Requirements Scanning".
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-document-intelligence-key

# --- Web API (app/web) ---
HOST=0.0.0.0
PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Design tools (backend/mcp-wrapper -> backend/tools-service) ---
# Diagram rendering and design validation moved out of this service as
# part of the tools-service split (see README -> "Service Architecture").
# This must point at backend/mcp-wrapper's "design-tools" gateway endpoint
# (its own DESIGN_TOOLS_WRAPPER_HOST/PORT/PATH settings determine the
# host/port/path below). Defaults to the standard local-dev address if
# unset.
DESIGN_TOOLS_MCP_URL=http://localhost:8200/mcp/design-tools

# --- Authentication (Entra ID) ---
# Leave AUTH_ENABLED=false for local development — every route is reachable
# without a token. Set it to true and fill in the tenant/client below to
# require a valid Entra ID bearer token.
AUTH_ENABLED=false
ENTRA_TENANT_ID=your-entra-tenant-id
ENTRA_CLIENT_ID=your-entra-app-registration-client-id
ENTRA_API_SCOPE=access_as_user

# --- Cosmos DB (web API session state) ---
# Backs the /requirements-runs endpoints (app/api/routes/requirements.py).
# The CLI does not use this — its session state lives only in the running
# process — so these are only required to run the web API.
COSMOS_ENDPOINT=https://your-cosmos-account.documents.azure.com:443/
COSMOS_KEY=your-cosmos-primary-key
COSMOS_DATABASE=requirements-to-design
COSMOS_SESSIONS_CONTAINER=sessions
# "key" (uses COSMOS_KEY above) or "managed_identity"
COSMOS_AUTH_MODE=key
