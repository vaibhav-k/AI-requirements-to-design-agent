# Gateway (Starlette app serving every wrapper's MCP endpoint on one port).
WRAPPERS_GATEWAY_HOST=127.0.0.1
WRAPPERS_GATEWAY_PORT=8200
WRAPPERS_GATEWAY_LOG_LEVEL=INFO

# The design-tools wrapper (diagram rendering + design validation).
DESIGN_TOOLS_WRAPPER_HOST=127.0.0.1
DESIGN_TOOLS_WRAPPER_PORT=8210
DESIGN_TOOLS_WRAPPER_PATH=/mcp/design-tools
DESIGN_TOOLS_WRAPPER_TOOLS_SERVICE_BASE_URL=http://localhost:8100
DESIGN_TOOLS_WRAPPER_TOOLS_SERVICE_TIMEOUT=60
